static func get_rule(fish_id: String) -> Dictionary:
	var rule = SPINNING_FISH_RULES.get(fish_id, DEFAULT_NONE_RULE)
	if rule is Dictionary:
		return (rule as Dictionary).duplicate(true)
	return DEFAULT_NONE_RULE.duplicate(true)


static func can_catch_on_spinning(fish_id: String) -> bool:
	var rule := get_rule(fish_id)
	return float(rule.get("spin_bite_modifier", 0.0)) > 0.0 and not rule.get("lure_types", []).is_empty()
